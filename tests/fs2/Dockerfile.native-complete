FROM rust:1.92.0-bookworm@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY vendor ./vendor
COPY src ./src
COPY benches ./benches
COPY crates ./crates
COPY tests ./tests
RUN --mount=type=cache,id=fs2-registry,target=/usr/local/cargo/registry --mount=type=cache,id=fs2-target,target=/src/target cargo test --locked -p magus-fs-core --test native_apply --features test-faults --no-run && cargo test --locked -p magus-fs --no-run && mkdir /out && for path in $(ls -t target/debug/deps/native_apply-*); do if [ -x "$path" ] && [ -f "$path" ]; then cp "$path" /out/native-tests; break; fi; done && for path in $(ls -t target/debug/deps/magus_fs-*); do if [ -x "$path" ] && [ -f "$path" ]; then cp "$path" /out/cli-tests; break; fi; done && test -x /out/native-tests && test -x /out/cli-tests && chmod 0755 /out /out/native-tests /out/cli-tests
