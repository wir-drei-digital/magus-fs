FROM rust:1.92.0-bookworm@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY vendor ./vendor
COPY src ./src
COPY benches ./benches
COPY crates ./crates
COPY tests ./tests
RUN --mount=type=cache,id=fs2-registry,target=/usr/local/cargo/registry --mount=type=cache,id=fs2-target,target=/src/target set -e; rustup component add --toolchain 1.92.0 clippy; cargo clippy --locked -p magus-fs-core -p magus-fs --all-targets --all-features -- -D warnings; mkdir /out; core=$(cargo test --locked -p magus-fs-core --test native_apply --features test-faults --no-run --message-format=json | grep '"test":true' | grep -o '"executable":"[^"]*"' | cut -d'"' -f4); cli=$(cargo test --locked -p magus-fs --bin magus-fs --no-run --message-format=json | grep '"test":true' | grep -o '"executable":"[^"]*"' | cut -d'"' -f4); test -n "$core" && test -n "$cli"; cp "$core" /out/native-tests; cp "$cli" /out/cli-tests; chmod 0755 /out /out/native-tests /out/cli-tests
