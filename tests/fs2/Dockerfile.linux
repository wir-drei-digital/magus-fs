FROM rust:1.92.0-bookworm@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2 AS builder
RUN rustup component add --toolchain 1.92.0 rustfmt clippy
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY vendor ./vendor
COPY src ./src
COPY benches ./benches
COPY crates ./crates
COPY tests ./tests
ARG VERIFY=1
RUN --mount=type=cache,id=fs2-registry,target=/usr/local/cargo/registry --mount=type=cache,id=fs2-target,target=/src/target if [ "$VERIFY" = service ]; then rustc --version --verbose && cargo fmt --all --check && cargo clippy --locked --workspace --all-targets --all-features -- -D warnings && cargo test --locked -p magus-fs-service --all-features; fi
RUN --mount=type=cache,id=fs2-registry,target=/usr/local/cargo/registry --mount=type=cache,id=fs2-target,target=/src/target if [ "$VERIFY" = client-fix ]; then rustc --version --verbose && cargo fmt --all --check && cargo clippy --locked -p magus-fs-core -p magus-fs --all-targets --all-features -- -D warnings && cargo test --locked -p magus-fs-core -p magus-fs --all-targets --all-features; fi
RUN --mount=type=cache,id=fs2-registry,target=/usr/local/cargo/registry --mount=type=cache,id=fs2-target,target=/src/target if [ "$VERIFY" = client ]; then rustc --version --verbose && cargo fmt --all --check && cargo clippy --locked -p magus-fs --all-targets --all-features -- -D warnings && cargo test --locked -p magus-fs --all-targets --all-features; fi
RUN --mount=type=cache,id=fs2-registry,target=/usr/local/cargo/registry --mount=type=cache,id=fs2-target,target=/src/target if [ "$VERIFY" = 1 ]; then rustc --version --verbose && cargo fmt --all --check && cargo clippy --locked --workspace --all-targets --all-features -- -D warnings && cargo test --locked --workspace --all-features; fi
RUN --mount=type=cache,id=fs2-registry,target=/usr/local/cargo/registry --mount=type=cache,id=fs2-target,target=/src/target cargo build --locked -p magus-fs-service --features test-faults && mkdir /out && cp target/debug/magus-fs-service /out/magus-fs-service-faults && cargo build --locked -p magus-fs-service && cp target/debug/magus-fs-service /out/magus-fs-service
RUN --mount=type=cache,id=fs2-registry,target=/usr/local/cargo/registry --mount=type=cache,id=fs2-target,target=/src/target cargo build --locked -p magus-fs --features test-faults && cp target/debug/magus-fs /out/magus-fs-client-faults && cargo build --locked -p magus-fs --examples && cp target/debug/examples/client_probe /out/client_probe && cargo build --locked -p magus-fs && cp target/debug/magus-fs /out/magus-fs
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates fuse3 util-linux && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/ /usr/local/bin/
COPY --from=builder /src/ /src/

ENV PYTHONPATH=/src/tests/fs1:/src/tests/fs0
RUN mkdir -p /opt && ln -s /src/tests/fs1 /opt/fs1 && ln -s /usr/local/bin/magus-fs-client-faults /usr/local/bin/magus-fs-faults
