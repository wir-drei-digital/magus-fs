FROM rust:1.92.0-bookworm@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2
RUN rustup component add --toolchain 1.92.0 rustfmt clippy
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY vendor ./vendor
COPY src ./src
COPY benches ./benches
COPY crates ./crates
COPY tests/*.rs ./tests/
COPY tests/fs0/permission_source.py ./tests/fs0/
COPY tests/fs1/test_cli.py ./tests/fs1/
RUN useradd --uid 1001 --create-home fs1test
RUN --mount=type=cache,id=fs0-task3-registry,target=/usr/local/cargo/registry --mount=type=cache,id=fs1-task4-target,target=/src/target \
    rustc --version --verbose && python3 --version && uname -a && \
    cargo fmt --all --check && cargo clippy --locked --workspace --all-targets --all-features -- -D warnings && \
    cargo test --locked -p magus-fs-core --lib --test capture --test materialize --test objects --test permissions --test working -- --nocapture && \
    cargo build --locked --workspace && mkdir -p /out && cp target/debug/magus-fs /out/magus-fs-default && \
    cargo test --locked -p magus-fs-core --test materialize --no-run --message-format=json > /tmp/task4-tests.json && \
    python3 -c 'import json,shutil; records=[json.loads(l) for l in open("/tmp/task4-tests.json")]; artifact=next(r for r in records if r.get("target",{}).get("name")=="materialize" and r.get("executable")); shutil.copy2(artifact["executable"],"/out/materialize-tests")' && \
    runuser -u fs1test -- /out/materialize-tests --nocapture && \
    runuser -u fs1test -- env MAGUS_FS_BIN=/out/magus-fs-default python3 -m unittest discover -s tests/fs1 -p test_cli.py && \
    cargo build --locked -p magus-fs --features test-faults && cp target/debug/magus-fs /out/magus-fs-faults && \
    runuser -u fs1test -- env MAGUS_FS_BIN=/out/magus-fs-faults MAGUS_TEST_FEATURES=test-faults python3 -m unittest discover -s tests/fs1 -p test_cli.py
