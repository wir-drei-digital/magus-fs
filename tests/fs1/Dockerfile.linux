FROM rust:1.92.0-bookworm@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2 AS builder
RUN rustup component add --toolchain 1.92.0 rustfmt clippy
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY vendor ./vendor
COPY src ./src
COPY benches ./benches
COPY crates ./crates
COPY tests ./tests
ARG VERIFY=0
RUN --mount=type=cache,id=fs0-task3-registry,target=/usr/local/cargo/registry --mount=type=cache,id=fs1-task5-target,target=/src/target if [ "$VERIFY" = 1 ]; then rustc --version --verbose && cargo fmt --all --check && cargo clippy --locked --workspace --all-targets --all-features -- -D warnings && cargo test --locked --workspace --all-features; fi
RUN --mount=type=cache,id=fs0-task3-registry,target=/usr/local/cargo/registry --mount=type=cache,id=fs1-task5-target,target=/src/target cargo build --locked -p magus-fs && mkdir /out && cp target/debug/magus-fs /out/magus-fs && cargo build --locked -p magus-fs --features test-faults && cp target/debug/magus-fs /out/magus-fs-faults && cargo test --locked -p magus-fs-core --test qualification --no-run --message-format=json > /out/test-build.json && python3 -c 'import json,shutil; records=[json.loads(s) for s in open("/out/test-build.json")]; path=next(r["executable"] for r in records if r.get("executable") and r.get("target",{}).get("name")=="qualification");shutil.copy2(path,"/out/fs1-retention")'
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install -y --no-install-recommends fuse3 python3 util-linux && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/ /usr/local/bin/
COPY --from=builder /out/ /out/
COPY --from=builder /src/ /src/
ENV PYTHONPATH=/src/tests/fs1:/src/tests/fs0
RUN mkdir -p /opt && ln -s /src/tests/fs1 /opt/fs1
