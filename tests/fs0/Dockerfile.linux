FROM rust:1.92.0-bookworm@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2 AS builder
RUN rustup component add --toolchain 1.92.0 rustfmt clippy
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY vendor ./vendor
COPY src ./src
COPY tests/*.rs ./tests/
COPY tests/fs0/permission_source.py ./tests/fs0/
RUN --mount=type=cache,id=fs0-task3-registry,target=/usr/local/cargo/registry --mount=type=cache,id=fs0-task3-target,target=/src/target rustc --version --verbose && cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings && cargo test --locked && cargo build --locked && mkdir -p /out && cp target/debug/magus-fs-probe /out/

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install -y --no-install-recommends fuse3 python3 util-linux && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/magus-fs-probe /usr/local/bin/magus-fs-probe
COPY tests/fs0/ordinary_io.py tests/fs0/linux_io.py tests/fs0/linux_daemon.py tests/fs0/root_confinement.py tests/fs0/permission_source.py tests/fs0/permission_io.py tests/fs0/lock_io.py tests/fs0/measurement_io.py /opt/fs0/
ENV PYTHONPATH=/opt/fs0
